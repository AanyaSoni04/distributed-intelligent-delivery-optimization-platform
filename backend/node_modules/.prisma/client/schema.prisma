generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example User model for DIDOP
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String // admin, driver, warehouse, customer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
