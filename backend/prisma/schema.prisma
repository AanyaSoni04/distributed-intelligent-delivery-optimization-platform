generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  DRIVER
  WAREHOUSE_OPERATOR
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?

  customerProfile  CustomerProfile?
  createdAddresses Address[]         @relation("AddressCreatedBy")
  updatedAddresses Address[]         @relation("AddressUpdatedBy")
  createdDeliveries Delivery[]       @relation("DeliveryCreatedBy")
  deliveryEvents   DeliveryEvent[]

  assignedByAssignments Assignment[] @relation("AssignmentCreatedBy")
  acceptedByAssignments Assignment[] @relation("AssignmentAcceptedBy")
  rejectedByAssignments Assignment[] @relation("AssignmentRejectedBy")
  assignmentEvents AssignmentEvent[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum AddressType {
  HOME
  OFFICE
  WAREHOUSE
  HUB
  OTHER
}

enum AddressStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model CustomerProfile {
  id               String     @id @default(uuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  phoneNumber      String
  companyName      String?
  totalDeliveries  Int        @default(0)
  activeDeliveries Int        @default(0)
  lastDeliveryAt   DateTime?
  addresses        Address[]
  deliveries       Delivery[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Address {
  id                   String        @id @default(uuid())
  customerId           String
  customer             CustomerProfile @relation(fields: [customerId], references: [id])
  addressType          AddressType
  status               AddressStatus @default(ACTIVE)
  
  // TODO: Address entity is intentionally reusable and should later support Warehouse, Hub, and other logistics modules instead of creating duplicate address tables.
  customLabel          String?
  contactName          String
  contactPhone         String
  addressLine1         String
  addressLine2         String?
  landmark             String?
  city                 String
  state                String
  postalCode           String
  country              String
  latitude             Float?
  longitude            Float?
  isDefault            Boolean       @default(false)
  isVerified           Boolean       @default(false)
  verifiedAt           DateTime?
  deliveryInstructions String?
  isDeleted            Boolean       @default(false)
  deletedAt            DateTime?

  createdByUserId      String
  createdByUser        User          @relation("AddressCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId      String?
  updatedByUser        User?         @relation("AddressUpdatedBy", fields: [updatedByUserId], references: [id])

  pickupDeliveries     Delivery[]    @relation("PickupAddress")
  deliveryDeliveries   Delivery[]    @relation("DeliveryAddress")

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// ─── Delivery Domain ─────────────────────────────────────────────────

enum DeliveryStatus {
  CREATED
  PICKUP_PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum AssignmentStatus {
  UNASSIGNED
  ASSIGNMENT_PENDING
  ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_REJECTED
  REASSIGNMENT_REQUIRED
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ServiceLevel {
  STANDARD
  SAME_DAY
  EXPRESS
}

enum PackageType {
  DOCUMENT
  BOX
  ELECTRONICS
  MEDICINE
  FOOD
  OTHER
}

enum EventSource {
  CUSTOMER
  SYSTEM
  DRIVER
  WAREHOUSE
  ADMIN
}

enum DeliverySource {
  CUSTOMER
  ADMIN
  WAREHOUSE
  API
  MARKETPLACE
}

enum AssignmentReason {
  AUTO
  MANUAL
  REASSIGNMENT
  SYSTEM
  HIGH_PRIORITY
}

enum AssignmentEventType {
  CREATED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  REASSIGNED
}

model TrackingCounter {
  id          Int      @id @default(1)
  year        Int
  lastCounter Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Delivery {
  id                       String           @id @default(uuid())
  trackingNumber           String           @unique
  clientRequestId          String?          @unique

  // Customer & Addresses
  customerId               String
  customer                 CustomerProfile  @relation(fields: [customerId], references: [id])
  pickupAddressId          String
  pickupAddress            Address          @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddressId        String
  deliveryAddress          Address          @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])

  // Warehouse Routing (future)
  originWarehouseId        String?
  destinationWarehouseId   String?

  // Driver (future Assignment Engine)
  driverId                 String?

  // Package
  packageWeight            Float
  packageLength            Float?
  packageWidth             Float?
  packageHeight            Float?
  packageType              PackageType
  packageValue             Float
  packageDescription       String

  // Status
  status                   DeliveryStatus   @default(CREATED)
  assignmentStatus         AssignmentStatus @default(UNASSIGNED)
  priorityLevel            PriorityLevel
  serviceLevel             ServiceLevel
  source                   DeliverySource

  // Scheduling & ETA
  scheduledPickupTime      DateTime?
  estimatedPickupTime      DateTime?
  estimatedDeliveryTime    DateTime?
  estimatedArrivalTime     DateTime?
  lastEtaCalculationAt     DateTime?
  actualDeliveryTime       DateTime?

  // Current Location Snapshot
  currentLatitude          Float?
  currentLongitude         Float?
  currentLocationUpdatedAt DateTime?

  // Miscellaneous
  specialInstructions      String?

  // Audit
  createdByUserId          String
  createdByUser            User             @relation("DeliveryCreatedBy", fields: [createdByUserId], references: [id])

  // Relations
  events                   DeliveryEvent[]
  assignments              Assignment[]

  // Timestamps
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([trackingNumber])
  @@index([customerId])
  @@index([status])
  @@index([assignmentStatus])
  @@index([createdAt])
  @@index([estimatedDeliveryTime])
  @@index([driverId])
}

model DeliveryEvent {
  id              String          @id @default(uuid())
  deliveryId      String
  delivery        Delivery        @relation(fields: [deliveryId], references: [id])
  eventType       String
  previousStatus  DeliveryStatus?
  currentStatus   DeliveryStatus
  source          EventSource
  message         String
  metadata        Json?
  createdByUserId String
  createdByUser   User            @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())

  @@index([deliveryId])
  @@index([createdAt])
  @@index([eventType])
}

model Assignment {
  id               String            @id @default(uuid())
  deliveryId       String
  delivery         Delivery          @relation(fields: [deliveryId], references: [id])
  driverId         String?           // No FK yet, Driver module will link later
  warehouseId      String?           // Future FK -> Warehouse

  status           AssignmentStatus  @default(ASSIGNMENT_PENDING)
  reason           AssignmentReason
  strategyUsed     String
  assignmentScore  Float?
  attemptNumber    Int

  expiresAt        DateTime?
  expiredAt        DateTime?
  isExpired        Boolean           @default(false)

  assignedAt       DateTime
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  completedAt      DateTime?

  assignedByUserId String
  assignedByUser   User              @relation("AssignmentCreatedBy", fields: [assignedByUserId], references: [id])
  acceptedByUserId String?
  acceptedByUser   User?             @relation("AssignmentAcceptedBy", fields: [acceptedByUserId], references: [id])
  rejectedByUserId String?
  rejectedByUser   User?             @relation("AssignmentRejectedBy", fields: [rejectedByUserId], references: [id])

  events           AssignmentEvent[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([deliveryId])
  @@index([driverId])
  @@index([status])
  @@index([assignedAt])
  @@index([expiresAt])
  @@index([isExpired])
}

model AssignmentEvent {
  id               String              @id @default(uuid())
  assignmentId     String
  assignment       Assignment          @relation(fields: [assignmentId], references: [id])
  sequenceNumber   Int
  eventType        AssignmentEventType
  previousStatus   AssignmentStatus?
  currentStatus    AssignmentStatus
  source           EventSource
  message          String
  metadata         Json?
  
  createdByUserId  String
  createdByUser    User                @relation(fields: [createdByUserId], references: [id])
  
  createdAt        DateTime            @default(now())

  @@index([assignmentId])
  @@index([createdAt])
  @@index([eventType])
  @@unique([assignmentId, sequenceNumber])
}
